#!/bin/sh
# NeonWrt first-boot UCI configuration generator.
# Runs under systemd before netifd/neon-uci and is safe to run repeatedly.

set -u

log() {
	printf '%s\n' "neon-config-generate: $*" >&2
}

mkdir -p /etc/config /tmp/.uci
chmod 0700 /tmp/.uci 2>/dev/null || true

# Generate board.json when a platform image did not provide it.
if [ ! -s /etc/board.json ]; then
	if [ -f /etc/uci-defaults/30_uboot-envtools ]; then
		( . /etc/uci-defaults/30_uboot-envtools ) || true
	fi

	log "generating /etc/board.json"
	if ! /bin/board_detect /tmp/board.json; then
		log "board_detect failed"
		exit 1
	fi

	if [ ! -s /tmp/board.json ]; then
		log "board_detect produced no board data"
		exit 1
	fi

	mv /tmp/board.json /etc/board.json
fi

# config_generate only creates missing UCI packages and therefore preserves
# user configuration on later boots.
if ! /bin/config_generate >/dev/null; then
	log "config_generate failed"
	exit 1
fi

# Defensive fallback: /etc/config/system is mandatory in NeonWrt because
# neon-uci and LuCI use it as the system configuration source of truth.
if [ ! -s /etc/config/system ]; then
	log "system config still missing; creating minimal fallback"
	touch /etc/config/system || exit 1
	uci -q batch <<'UCI_EOF' || exit 1
add system system
set system.@system[-1].hostname='NeonWrt'
set system.@system[-1].timezone='GMT0'
set system.@system[-1].zonename='UTC'
set system.@system[-1].ttylogin='0'
set system.@system[-1].log_size='128'
set system.@system[-1].urandom_seed='0'
set system.ntp='timeserver'
set system.ntp.enabled='1'
set system.ntp.enable_server='0'
add_list system.ntp.server='0.openwrt.pool.ntp.org'
add_list system.ntp.server='1.openwrt.pool.ntp.org'
add_list system.ntp.server='2.openwrt.pool.ntp.org'
add_list system.ntp.server='3.openwrt.pool.ntp.org'
UCI_EOF
	uci -q commit system || exit 1
fi

# Apply the generated hostname immediately, without depending on hostname(1),
# hostnamectl, D-Bus, or systemd-hostnamed. neon-uci will keep this synchronized
# after later UCI commits.
HOSTNAME_VALUE="$(uci -q get 'system.@system[0].hostname' 2>/dev/null || true)"
if [ -n "$HOSTNAME_VALUE" ]; then
	printf '%s\n' "$HOSTNAME_VALUE" > /etc/hostname 2>/dev/null || true
	printf '%s\n' "$HOSTNAME_VALUE" > /proc/sys/kernel/hostname 2>/dev/null || true
fi

log "UCI base configuration ready"
exit 0
