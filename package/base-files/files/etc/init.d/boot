#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2011 OpenWrt.org

START=10
STOP=90

uci_apply_defaults() {
	. /lib/functions/system.sh

	cd /etc/uci-defaults || return 0
	files="$(ls)"
	[ -z "$files" ] && return 0
	applied=""
	for file in $files; do
		( . "./$(basename $file)" ) && applied="$applied $file"
	done
	uci commit
	sync
	rm -f $applied
}

boot() {
	[ -f /proc/mounts ] || /sbin/mount_root
	[ -f /proc/jffs2_bbc ] && echo "S" > /proc/jffs2_bbc

	# NeonWrt/systemd runtime hierarchy.  /run is the primary runtime tmpfs;
	# keep the traditional /var/run and /var/lock names as compatibility links.
	mkdir -p /run /run/lock /var/log /var/state /var/tmp
	chmod 0755 /run
	chmod 1777 /run/lock /var/tmp
	if [ ! -L /var/run ]; then
		rm -rf /var/run
		ln -s /run /var/run
	fi
	if [ ! -L /var/lock ]; then
		rm -rf /var/lock
		ln -s /run/lock /var/lock
	fi
	mkdir -p /var/tmp
	mkdir -p /tmp/.uci
	chmod 0700 /tmp/.uci
	touch /var/log/wtmp
	touch /var/log/lastlog
	mkdir -p /tmp/resolv.conf.d
	touch /tmp/resolv.conf.d/resolv.conf.auto
	ln -sf /tmp/resolv.conf.d/resolv.conf.auto /tmp/resolv.conf
	grep -q debugfs /proc/filesystems && /bin/mount -o nosuid,nodev,noexec,noatime -t debugfs debugfs /sys/kernel/debug
	grep -q bpf /proc/filesystems && /bin/mount -o nosuid,nodev,noexec,noatime,mode=0700 -t bpf bpffs /sys/fs/bpf
	grep -q pstore /proc/filesystems && /bin/mount -o nosuid,nodev,noexec,noatime -t pstore pstore /sys/fs/pstore
	[ "$FAILSAFE" = "true" ] && touch /tmp/.failsafe

	# Kernel modules are loaded earlier by neon-kmodloader.service.
	# Generate only the initial wireless UCI configuration here. The helper
	# waits for nl80211/PHY detection to become usable, but does NOT bring the
	# radio up. Runtime remains owned by netifd + wpad/hostapd.
	if [ -x /usr/libexec/neon-wifi-config ]; then
		/usr/libexec/neon-wifi-config || \
			echo "boot: warning: initial wireless config generation failed" >&2
	fi

	# Apply one-shot factory defaults after wireless detection so the logical
	# LAN exists before netifd starts and the generated radio is enabled as AP.
	uci_apply_defaults
	sync

	# temporary hack until configd exists
	/sbin/reload_config
}
