#!/bin/sh
set -eu
. /usr/libexec/neon-uci/common.sh

[ "${1:-}" = "apply" ] || exit 2

storage="$(uci_get 'neon_systemd.journald.storage' 'volatile')"
compress="$(uci_bool "$(uci_get 'neon_systemd.journald.compress' '1')" yes)"
system_max_use="$(uci_get 'neon_systemd.journald.system_max_use' '')"
runtime_max_use="$(uci_get 'neon_systemd.journald.runtime_max_use' '32M')"
rate_interval="$(uci_get 'neon_systemd.journald.rate_limit_interval_sec' '30s')"
rate_burst="$(uci_get 'neon_systemd.journald.rate_limit_burst' '10000')"
forward_console="$(uci_bool "$(uci_get 'neon_systemd.journald.forward_to_console' '0')" no)"

case "$storage" in
    volatile|persistent|auto|none) ;;
    *) log "invalid journald storage '$storage'"; exit 1 ;;
esac

for v in "$system_max_use" "$runtime_max_use" "$rate_interval" "$rate_burst"; do
    [ -z "$v" ] || safe_simple_value "$v" || {
        log "unsafe journald value '$v'"
        exit 1
    }
done

{
    echo '# Generated by neon-uci from /etc/config/neon_systemd. Do not edit.'
    echo '[Journal]'
    printf 'Storage=%s\n' "$storage"
    printf 'Compress=%s\n' "$compress"
    [ -z "$system_max_use" ] || printf 'SystemMaxUse=%s\n' "$system_max_use"
    [ -z "$runtime_max_use" ] || printf 'RuntimeMaxUse=%s\n' "$runtime_max_use"
    [ -z "$rate_interval" ] || printf 'RateLimitIntervalSec=%s\n' "$rate_interval"
    [ -z "$rate_burst" ] || printf 'RateLimitBurst=%s\n' "$rate_burst"
    printf 'ForwardToConsole=%s\n' "$forward_console"
} | atomic_write /run/systemd/journald.conf.d/50-neon-uci.conf 0644
