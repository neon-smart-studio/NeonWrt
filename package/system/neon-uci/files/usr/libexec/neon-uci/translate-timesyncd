#!/bin/sh
set -eu
. /usr/libexec/neon-uci/common.sh

[ "${1:-}" = "apply" ] || exit 2

# OpenWrt's default system config normally uses a named 'ntp' section,
# but accept the first anonymous timeserver section as fallback.
enabled="$(uci_get 'system.ntp.enabled' '')"
[ -n "$enabled" ] || enabled="$(uci_get 'system.@timeserver[0].enabled' '1')"

servers="$(uci_list 'system.ntp.server' ' ')"
[ -n "$servers" ] || servers="$(uci_list 'system.@timeserver[0].server' ' ')"

enabled="$(uci_bool "$enabled" yes)"

# Reject values that could break the generated INI file.
for s in $servers; do
    safe_simple_value "$s" || {
        log "unsafe NTP server value '$s'"
        exit 1
    }
done

{
    echo '# Generated by neon-uci from /etc/config/system. Do not edit.'
    echo '[Time]'
    if [ "$enabled" = yes ]; then
        printf 'NTP=%s\n' "$servers"
        # Keep UCI as the single source of truth; do not silently add distro fallback servers.
        echo 'FallbackNTP='
    else
        echo 'NTP='
        echo 'FallbackNTP='
    fi
} | atomic_write /run/systemd/timesyncd.conf.d/50-neon-uci.conf 0644
